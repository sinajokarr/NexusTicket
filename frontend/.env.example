# Leave blank only to use the localized, fictional demo inventory.
# Connected mode expects the local API server, including its secure demo-payment redirect.
# Example: VITE_API_URL=http://127.0.0.1:8011
VITE_API_URL=

# Optional ISO-4217 currency for prices returned by a connected API (defaults to USD).
# Example for an IRR-priced API: VITE_CURRENCY=IRR
VITE_CURRENCY=
