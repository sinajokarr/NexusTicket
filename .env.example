# Local development defaults. Copy to .env and replace all placeholder values.
DEBUG=True
SECRET_KEY=replace-this-with-a-long-random-development-secret
DATABASE_URL=sqlite:///db.sqlite3
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
FRONTEND_BASE_URL=http://127.0.0.1:5173
PAYMENT_PUBLIC_BASE_URL=http://127.0.0.1:8011
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
ALLOWED_HOSTS=localhost,127.0.0.1
NEXUSTICKET_PORT=8011

# Required when running the MySQL Docker stack. Never use this example value in production.
MYSQL_DATABASE=events
MYSQL_ROOT_PASSWORD=replace-with-a-local-dev-password
